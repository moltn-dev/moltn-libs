// Generated by moltn. Do not edit.
// Props types come from Rust structs (ts-rs). Updated when the application starts
// in debug, or by `moltn gen`; checked in CI by `moltn gen --check`.

export type JsonValue = number | string | boolean | Array<JsonValue> | { [key in string]: JsonValue } | null;

export type Shared = { app_name: string, };

export type UserProps = { id: number, greeting: string, isAdmin: boolean, };

/** Props of each page, by component: `defineProps<Pages['users/[id]']>()`. */
export interface Pages {
  'about': {}
  'docs/[...slug]': JsonValue
  'player': JsonValue
  'tabs/[[tab]]': JsonValue
  'teams/[teamId]': JsonValue
  'users/[id]': UserProps
}

/** Props shared by every page (`moltn_pages::shared_props!`). */
export type SharedProps = Shared

// Inertia's global typing: `usePage().props` knows the shared props.
declare module '@inertiajs/core' {
  interface InertiaConfig {
    sharedPageProps: SharedProps
  }
}

/** URL parameters of each page, by component. */
export interface RouteParams {
  'about': {}
  'docs/[...slug]': { slug: string[] }
  'player': {}
  'tabs/[[tab]]': { tab?: string | number }
  'teams/[teamId]': { teamId: string | number }
  'users/[id]': { id: string | number }
}

const templates: Record<keyof RouteParams, string> = {
  'about': '/about',
  'docs/[...slug]': '/docs/{*slug}',
  'player': '/player',
  'tabs/[[tab]]': '/tabs/{tab?}',
  'teams/[teamId]': '/teams/{teamId}',
  'users/[id]': '/users/{id}',
}

type Query = Record<string, string | number>
type Args<K extends keyof RouteParams> = {} extends RouteParams[K]
  ? [params?: RouteParams[K], query?: Query]
  : [params: RouteParams[K], query?: Query]

/** URL of a page: `route('users/[id]', { id: 42 })` → `/users/42`. */
export function route<K extends keyof RouteParams>(name: K, ...[params, query]: Args<K>): string {
  const values = (params ?? {}) as Record<string, string | number | string[] | undefined>
  let path = templates[name].replace(/\/\{(\*?)(\w+)(\??)\}/g, (_, star: string, key: string, optional: string) => {
    const value = values[key]
    if (value === undefined || (Array.isArray(value) && value.length === 0)) {
      if (optional) return ''
      throw new Error(`route('${name}'): missing parameter "${key}"`)
    }
    const parts = star ? (value as string[]) : [String(value)]
    return '/' + parts.map(encodeURIComponent).join('/')
  })
  if (path === '') path = '/'
  const search = new URLSearchParams(Object.entries(query ?? {}).map(([k, v]) => [k, String(v)])).toString()
  return search ? `${path}?${search}` : path
}
